# Example environment variables for UnderGroundZone
# Copy to .env and fill values before running

# Secret used to verify incoming webhooks (HMAC-SHA256). If empty, webhook verification is disabled (dev only).
CRYPTO_WEBHOOK_SECRET=change_me

# Admin secret to protect admin endpoints (/admin/* and /giveaway/start|end|grant)
ADMIN_SECRET=change_me

# Telegram bot token (optional) — not stored here, used by integrations if implemented
BOT_TOKEN=your_telegram_bot_token_here

# Port the app listens on
PORT=5000

# Local fallback path to SQLite database file
DATABASE=./data.sqlite3

# When deploying to Railway or another managed Postgres, DATABASE_URL will be provided by the platform.
# Example: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:port/dbname
