# Example environment variables for UnderGroundZone
# Copy to .env and fill values before running

FLASK_ENV=production
SECRET_KEY=replace_with_a_random_secret
DATABASE_URL=sqlite:///data.db
TELEGRAM_MINI_APP_ID=your_telegram_mini_app_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
CRYPTO_WEBHOOK_SECRET=replace_with_crypto_webhook_secret
GIVEAWAY_THRESHOLD_USD=15
GITHUB_RAW_BASE=https://raw.githubusercontent.com/atomowabomba3-boop/UnderGroundZone/main/ebooks
PORT=8000
